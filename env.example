# =============================================================
# ShanghaiTech Auth - Production Environment Variables
# Copy this file to .env and fill in the values
# =============================================================

# --- URLs ---
# Your Next.js app's public URL (where users access it)
APP_URL=https://auth.example.com
# Hydra's public URL (where browsers reach Hydra for OAuth flows)
HYDRA_PUBLIC_URL=https://hydra.example.com

# --- Ports (host binding, optional) ---
APP_PORT=3000
HYDRA_PUBLIC_PORT=4444

# --- OAuth Client ---
CLIENT_ID=shanghaitech-auth
CLIENT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
CLIENT_NAME=ShanghaiTech Auth
CLIENT_SCOPE=openid profile email
GRANT_TYPES=authorization_code,refresh_token

# --- Hydra Secrets (MUST change in production) ---
# Generate with: openssl rand -hex 32
SECRETS_SYSTEM=CHANGE_ME_generate_with_openssl_rand_hex_32
OIDC_PAIRWISE_SALT=CHANGE_ME_generate_with_openssl_rand_hex_32
